# .env.example : template for your private settings.
# Copy it to ".env" (cp .env.example .env  |  copy .env.example .env) and fill it in.
# Never commit .env: it holds your secret key (.gitignore already excludes it).

# Your Groq API key (required for the chat app, NOT needed to run/test the MCP server or client).
GROQ_API_KEY=""                    # https://console.groq.com/keys
# Which Groq model to use. It must support tool calling.
GROQ_MODEL="openai/gpt-oss-120b"
# How hard the model "thinks": low (fast/cheap) | medium | high. GPT-OSS models only.
GROQ_REASONING_EFFORT="medium"     # low | medium | high (GPT-OSS models only)
# How main.py launches MCP server scripts in stdio mode:
#   0 = with the Python running the app (sys.executable). Works for uv AND pip. Default.
#   1 = with `uv run <script>`.
USE_UV=0

# ---- Connecting to the MCP server over HTTP (production-like) -----------------------
# Leave MCP_SERVER_URL empty for the default stdio mode (the app starts the server itself).
# To use HTTP: start the server in ANOTHER terminal first, then set the URL (note the /mcp):
#   fastmcp run mcp_server.py --transport http --port 8000
#   MCP_SERVER_URL="http://127.0.0.1:8000/mcp"
MCP_SERVER_URL=""
# Optional bearer token, sent as "Authorization: Bearer <token>" (HTTP mode only).
# Only needed if your server checks it. The local demo server does not.
MCP_AUTH_TOKEN=""
